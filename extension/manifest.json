{
  "manifest_version": 3,
  "name": "Job Application Autofill",
  "version": "1.0.0",
  "description": "Autofills job application forms from a locked answer bank. Never submits — a human always clicks submit.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "commands": {
    "trigger-fill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill the current job application page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "lib/fuzzy.js",
        "lib/option-matcher.js",
        "lib/workauth-matcher.js",
        "lib/eeo-strings.js",
        "data/match-rules.js",
        "content/matcher.js",
        "content/detector.js",
        "content/filler.js",
        "content/observer.js",
        "content/review-panel.js",
        "content/ats-adapters/generic.js",
        "content/ats-adapters/workday.js",
        "content/ats-adapters/greenhouse.js",
        "content/ats-adapters/icims.js",
        "content/ats-adapters/taleo.js",
        "content/ats-adapters/lever.js",
        "content/ats-adapters/ashby.js",
        "content/ats-adapters/smartrecruiters.js",
        "content/ats-adapters/tier3-hints.js",
        "content/content-main.js"
      ]
    }
  ]
}
