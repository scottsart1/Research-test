# Snowflake credentials
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=THREAT_SUPPLY_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=SYSADMIN

# FRED API (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key

# NVD API key (optional but helps with rate limits - free at nvd.nist.gov)
NVD_API_KEY=your_nvd_api_key

# Census Bureau API key (free at api.census.gov/data/key_signup.html)
CENSUS_API_KEY=your_census_api_key

# Dashboard mode: "snowflake" or "local" (uses cached parquet files)
DASHBOARD_MODE=local
